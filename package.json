{
  "name": "timezonehelper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "FORCE_COLOR=1 bun --bun vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.19",
    "@vvo/tzdb": "^6.198.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web": "^0.0.354",
    "@vitejs/plugin-react": "^6.1.0",
    "browserslist": "^4.24.0",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.3.14",
    "eslint-plugin-compat": "^7.0.2",
    "knip": "^6.33.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
}
